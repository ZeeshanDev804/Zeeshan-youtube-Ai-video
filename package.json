{
  "name": "zeeshan-youtube-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/orchestrator.mjs",
  "scripts": {
    "start": "node src/orchestrator.mjs",
    "generate": "node src/orchestrator.mjs",
    "check": "node --check src/orchestrator.mjs && node --check src/config/index.mjs && node --check src/modules/scriptEngine.mjs && node --check src/modules/visualEngine.mjs && node --check src/modules/voiceEngine.mjs && node --check src/modules/renderEngine.mjs && node --check src/modules/qualityEngine.mjs",
    "test:imports": "node -e \"import('./src/config/index.mjs').then(()=>import('./src/store.mjs')).then(()=>import('./src/modules/scriptEngine.mjs')).then(()=>import('./src/modules/visualEngine.mjs')).then(()=>import('./src/modules/voiceEngine.mjs')).then(()=>import('./src/modules/renderEngine.mjs')).then(()=>import('./src/modules/qualityEngine.mjs')).then(()=>console.log('All core modules imported successfully.')).catch(error=>{console.error(error);process.exit(1)})\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^1.14.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "fluent-ffmpeg": "^2.1.2",
    "gtts": "^0.2.1"
  }
}