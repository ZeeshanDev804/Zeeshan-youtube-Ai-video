import fs from "fs";
import path from "path";
import { execFile } from "child_process";
import { promisify } from "util";

const execFileAsync = promisify(execFile);

const DEFAULT_VOLUME = Number(
  process.env.BACKGROUND_MUSIC_VOLUME ?? 0.10
);

const DEFAULT_MUSIC_PATH = path.resolve(
  process.env.BACKGROUND_MUSIC_PATH ??
    "./output/music/background.mp3"
);

function assertValidVolume(volume) {
  if (!Number.isFinite(volume) || volume < 0 || volume > 1) {
    throw new Error(
      `[MusicEngine] Invalid music volume: ${volume}. Use 0.0 to 1.0.`
    );
  }
}

async function runFFmpeg(args) {
  try {
    console.log(
      `[MusicEngine] FFmpeg args: ${JSON.stringify(args)}`
    );

    await execFileAsync("ffmpeg", args, {
      maxBuffer: 1024 * 1024 * 20
    });
  } catch (error) {
    const details =
      error?.stderr ||
      error?.stdout ||
      error?.message ||
      "Unknown FFmpeg error";

    throw new Error(
      `[MusicEngine] FFmpeg failed: ${details}`
    );
  }
}

async function runFFprobe(args) {
  try {
    const { stdout } = await execFileAsync("ffprobe", args, {
      maxBuffer: 1024 * 1024 * 10
    });

    return stdout.trim();
  } catch (error) {
    const details =
      error?.stderr ||
      error?.stdout ||
      error?.message ||
      "Unknown FFprobe error";

    throw new Error(
      `[MusicEngine] FFprobe failed: ${details}`
    );
  }
}

export function getBackgroundMusicPath() {
  return DEFAULT_MUSIC_PATH;
}

export function validateMusicFile(musicPath = DEFAULT_MUSIC_PATH) {
  if (!fs.existsSync(musicPath)) {
    throw new Error(
      `[MusicEngine] Background music file not found: ${musicPath}`
    );
  }

  const stats = fs.statSync(musicPath);

  if (!stats.isFile()) {
    throw new Error(
      `[MusicEngine] Background music path is not a file: ${musicPath}`
    );
  }

  if (stats.size <= 0) {
    throw new Error(
      `[MusicEngine] Background music file is empty: ${musicPath}`
    );
  }

  console.log(
    `[MusicEngine] Background music size: ${stats.size} bytes`
  );

  return true;
}

async function isMusicFileReadable(musicPath) {
  try {
    validateMusicFile(musicPath);

    const output = await runFFprobe([
      "-v",
      "error",
      "-select_streams",
      "a:0",
      "-show_entries",
      "stream=codec_name,duration",
      "-of",
      "default=noprint_wrappers=1:nokey=0",
      musicPath
    ]);

    if (!output || !output.includes("codec_name=")) {
      console.warn(
        `[MusicEngine] FFprobe could not detect a valid audio stream`
      );

      return false;
    }

    console.log(
      `[MusicEngine] Background music FFprobe validation passed`
    );

    return true;
  } catch (error) {
    console.warn(
      `[MusicEngine] Background music validation failed: ${error.message}`
    );

    return false;
  }
}

async function createSilentMusic(duration, outputPath) {
  if (!Number.isFinite(duration) || duration <= 0) {
    throw new Error(
      `[MusicEngine] Invalid silent music duration: ${duration}`
    );
  }

  fs.mkdirSync(path.dirname(outputPath), {
    recursive: true
  });

  console.warn(
    `[MusicEngine] Creating silent background music: ${duration.toFixed(3)}s`
  );

  await runFFmpeg([
    "-y",

    "-f",
    "lavfi",

    "-i",
    "anullsrc=channel_layout=stereo:sample_rate=48000",

    "-t",
    duration.toFixed(3),

    "-vn",

    "-c:a",
    "aac",

    "-b:a",
    "192k",

    "-ar",
    "48000",

    outputPath
  ]);

  if (!fs.existsSync(outputPath)) {
    throw new Error(
      `[MusicEngine] Silent background music was not created: ${outputPath}`
    );
  }

  const stats = fs.statSync(outputPath);

  if (stats.size <= 0) {
    throw new Error(
      `[MusicEngine] Silent background music is empty: ${outputPath}`
    );
  }

  return outputPath;
}

export async function getMusicDuration(
  musicPath = DEFAULT_MUSIC_PATH
) {
  validateMusicFile(musicPath);

  const readable = await isMusicFileReadable(musicPath);

  if (!readable) {
    throw new Error(
      `[MusicEngine] Background music is not a valid readable audio file: ${musicPath}`
    );
  }

  const output = await runFFprobe([
    "-v",
    "error",
    "-show_entries",
    "format=duration",
    "-of",
    "default=noprint_wrappers=1:nokey=1",
    musicPath
  ]);

  const duration = Number(output);

  if (!Number.isFinite(duration) || duration <= 0) {
    throw new Error(
      `[MusicEngine] Invalid music duration: ${output}`
    );
  }

  return duration;
}

export async function prepareBackgroundMusic(
  duration,
  outputPath,
  options = {}
) {
  if (!Number.isFinite(duration) || duration <= 0) {
    throw new Error(
      `[MusicEngine] Invalid target duration: ${duration}`
    );
  }

  const musicPath =
    options.musicPath || DEFAULT_MUSIC_PATH;

  const volume =
    options.volume ?? DEFAULT_VOLUME;

  assertValidVolume(volume);

  fs.mkdirSync(path.dirname(outputPath), {
    recursive: true
  });

  console.log(
    `[MusicEngine] Preparing background music: ${duration.toFixed(3)}s`
  );

  console.log(
    `[MusicEngine] Source music: ${musicPath}`
  );

  console.log(
    `[MusicEngine] Music volume: ${volume}`
  );

  /*
   * IMPORTANT:
   * First verify that the source file is actually readable.
   * A file can exist and still be a corrupt MP3.
   */
  const readable = await isMusicFileReadable(musicPath);

  if (!readable) {
    console.warn(
      `[MusicEngine] Source background music is invalid or corrupt.`
    );

    console.warn(
      `[MusicEngine] Using exact-duration silent background track instead.`
    );

    return createSilentMusic(
      duration,
      outputPath
    );
  }

  const args = [
    "-y",

    "-stream_loop",
    "-1",

    "-i",
    musicPath,

    "-t",
    duration.toFixed(3),

    "-vn",

    "-af",
    [
      `volume=${volume}`,
      "aresample=48000",
      `atrim=duration=${duration.toFixed(3)}`,
      "asetpts=N/SR/TB"
    ].join(","),

    "-c:a",
    "aac",

    "-b:a",
    "192k",

    "-ar",
    "48000",

    outputPath
  ];

  console.log(
    `[MusicEngine] FFmpeg command: ffmpeg ${args.join(" ")}`
  );

  try {
    await runFFmpeg(args);
  } catch (error) {
    console.warn(
      `[MusicEngine] Background music processing failed.`
    );

    console.warn(
      `[MusicEngine] Reason: ${error.message}`
    );

    console.warn(
      `[MusicEngine] Creating exact-duration silent background track.`
    );

    return createSilentMusic(
      duration,
      outputPath
    );
  }

  if (!fs.existsSync(outputPath)) {
    throw new Error(
      `[MusicEngine] Prepared music was not created: ${outputPath}`
    );
  }

  const stats = fs.statSync(outputPath);

  if (stats.size <= 0) {
    throw new Error(
      `[MusicEngine] Prepared music is empty: ${outputPath}`
    );
  }

  return outputPath;
}

export async function mixNarrationAndMusic(
  narrationPath,
  musicPath,
  outputPath,
  duration
) {
  if (!fs.existsSync(narrationPath)) {
    throw new Error(
      `[MusicEngine] Narration file not found: ${narrationPath}`
    );
  }

  if (!fs.existsSync(musicPath)) {
    throw new Error(
      `[MusicEngine] Music file not found: ${musicPath}`
    );
  }

  if (!Number.isFinite(duration) || duration <= 0) {
    throw new Error(
      `[MusicEngine] Invalid mix duration: ${duration}`
    );
  }

  fs.mkdirSync(path.dirname(outputPath), {
    recursive: true
  });

  console.log(
    `[MusicEngine] Mixing narration + background music`
  );

  const args = [
    "-y",

    "-i",
    narrationPath,

    "-i",
    musicPath,

    "-filter_complex",
    [
      "[0:a]aresample=48000,asetpts=PTS-STARTPTS[narration]",
      "[1:a]aresample=48000,asetpts=PTS-STARTPTS[music]",
      "[narration][music]amix=inputs=2:duration=first:dropout_transition=2:normalize=0[mixed]",
      `[mixed]atrim=duration=${duration.toFixed(3)},asetpts=N/SR/TB[outa]`
    ].join(";"),

    "-map",
    "[outa]",

    "-c:a",
    "aac",

    "-b:a",
    "192k",

    "-ar",
    "48000",

    outputPath
  ];

  console.log(
    `[MusicEngine] Mix FFmpeg command: ffmpeg ${args.join(" ")}`
  );

  await runFFmpeg(args);

  if (!fs.existsSync(outputPath)) {
    throw new Error(
      `[MusicEngine] Mixed audio was not created: ${outputPath}`
    );
  }

  const stats = fs.statSync(outputPath);

  if (stats.size <= 0) {
    throw new Error(
      `[MusicEngine] Mixed audio is empty: ${outputPath}`
    );
  }

  return outputPath;
}

export default {
  getBackgroundMusicPath,
  validateMusicFile,
  getMusicDuration,
  prepareBackgroundMusic,
  mixNarrationAndMusic
};